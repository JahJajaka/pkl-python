// Construction semantics per https://pkl-lang.org/package-docs/pkl/current/base/IntSeq.html:
// IntSeq(start, end) defaults step=1; .step(n) overrides it.
module intseq

res1: IntSeq = IntSeq(2, 5)
res2: IntSeq = IntSeq(5, 2).step(-2)
